# Copiar como server/.env  (NUNCA subir .env a git)
PORT=4000
# Origen permitido para CORS (la Vista). En producción pongan la URL de Firebase Hosting.
CORS_ORIGIN=*
# Opcional: forzar carpeta de datos (por defecto usa ../data/processed y, si está vacía, ../data/sample)
# DATA_DIR=../data/processed
# Opcional: Firestore (si no está, las regiones salen de ../data/regions.json)
# FIREBASE_SERVICE_ACCOUNT=../serviceAccount.json

# NASA FIRMS
FIRMS_MAP_KEY=

# API WMS de la Alcaldía de Cochabamba (GAMC) — proyecto 03 "Harmonization of MODIS and VIIRS"
# La key está en https://recursosgamc.cochabamba.bo/api-doc -> proyecto 03 -> "Copiar KEY"
GAMC_API_KEY=
GAMC_WMS_URL=https://serviciosgamc.cochabamba.bo/api/gs/wms
GAMC_SERVICE_DISTRITOS=7eb13092-bf0e-493b-aae6-03c43eedda2c
GAMC_SERVICE_COTA2750=297cefa4-0832-42bb-a98e-2cbea989fd9d
GAMC_SERVICE_PERIURBANOS=c52066a1-32fd-4925-81e0-c2dcb8f4238f
